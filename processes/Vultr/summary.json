    "ApiKey",
    "BareMetal",
    "BlockStorage",
    "CDN",
    "Catalog",
    "ContainerRegistry",
    "DNS",
    "Database",
    "Firewall",
    "Inference",
    "Instance",
    "Iso",
    "Kubernetes",
    "LoadBalancer",
    "ObjectStorage",
    "Oidc",
    "Organization",
    "ReservedIp",
    "ReverseDns",
    "Snapshot",
    "SshKey",
    "StartupScript",
    "User",
    "Vfs",
    "Vpc"
  ]
}
